# Server only. Never prefix secrets with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
STUDY_SESSION_SECRET=
# Enrollment is closed unless explicitly true. Existing sessions can finish.
STUDY_ENROLLMENT_OPEN=false
# walkthrough is simulated/no storage; test uses real storage; prolific verifies submission IDs.
STUDY_MODE=test
STUDY_TEST_OPEN_ENTRY=false
STUDY_INVITE_CODE=
STUDY_AI_ACCESS=both
# Pilot only: allow ?condition=rough|final|both with verified Prolific entry.
# Test/walkthrough deployments already allow this. Keep false for randomized recruitment.
STUDY_ALLOW_CONDITION_OVERRIDE=false
PROLIFIC_API_TOKEN=
PROLIFIC_STUDY_ID=
PROLIFIC_COMPLETION_CODE=
WRITING_MODEL=gpt-6-luna
RECALL_MODEL=gpt-6.1-sol
# Optional recall prompt override; must contain [STORY].
# RECALL_PROMPT=
# Local simulated preview only:
VITE_WRITING_AI_ACCESS=both
VITE_FAST_PREVIEW=false
RECALL_PREVIEW_LIVE=false

# Set only for a hosted walkthrough build, never the participant study build.
VITE_HOSTED_PREVIEW=false
# Optional server-selected condition; random-noun uses both writing phases.
# STUDY_CONDITION=random-noun
